// Этот файл настраивает боевое поведение для различных ролей.
// target_weights определяет приоритет выбора целей.
// heal_thresholds управляет действиями исцеления.
// skill_preference определяет приоритет использования навыков.
{
  "strategies": {
    "carry": {
      // Роль Carry: Приоритет нанесения урона целям с низким HP. Избегает получения агрессии.
      "target_weights": {
        // Вес для угрозы/аггро цели. Отрицательное значение означает, что керри избегает целей с высоким аггро.
        "aggro": -0.5,
        // Вес для процента здоровья цели. Отрицательные значения фокусируют керри на целях с низким HP (добивание).
        "hp_percent": -2.0,
        // Вес для базового урона цели. Положительные значения приоритезируют более опасных противников.
        "base_damage": 1.5
      },
      // Порог HP (от 0.0 до 1.0), ниже которого керри попытается исцелить себя.
      "heal_threshold_self": 0.3,
      // Предпочтительный порядок активации навыков оружия/брони.
      "skill_preference": ["multi_strike", "ignore_armor", "aoe"]
    },
    "tank": {
      // Роль Tank: Приоритет целей с высокой угрозой для накопления аггро и защиты союзников. Предпочтение саморемонту.
      "target_weights": {
        "aggro": 0.5,
        "hp_percent": -0.5,
        "base_damage": 1.0
      },
      "heal_threshold_self": 0.4,
      "skill_preference": ["apply_effect_self", "counter_attack", "self_repair"]
    },
    "support": {
      // Роль Support: Фокусируется на лечении союзников и наложении баффов/дебаффов.
      "target_weights": {
        "aggro": 0.0,
        "hp_percent": -1.0,
        "base_damage": 0.5
      },
      "heal_threshold_self": 0.4,
      // Порог HP (от 0.0 до 1.0), ниже которого поддержка будет лечить союзника.
      "heal_threshold_ally": 0.6,
      "skill_preference": ["apply_effect_self", "apply_effect_enemy"]
    }
  }
}
