MONGO_USERNAME=
MONGO_PASSWORD=
REDIS_PASSWORD=redis_dino_secret

BOT_TOKEN=

# --- Nginx / Webhook ---
# Доменное имя сервера (используется как server_name в nginx и для setWebhook)
NGINX_SERVER_NAME=example.ddns.net
# Путь к директории с SSL-сертификатами на хосте (fullchain.pem и privkey.pem)
SSL_CERT_DIR=/root/cert/example.ddns.net

# Переименуйте файл в .env и заполните все поля перед запуском